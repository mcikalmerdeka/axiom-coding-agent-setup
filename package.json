{
  "name": "axiom-coding-agent-setup",
  "version": "2.0.0",
  "description": "CLI tool to download AXIOM coding agent setup files into your project",
  "main": "bin/cli.js",
  "files": [
    "bin/",
    ".agents/",
    "AGENTS.md",
    "opencode.json",
    ".env.axiom",
    "README.md",
    "skills-lock.json"
  ],
  "bin": {
    "axiom-coding-agent-setup": "bin/cli.js",
    "axiom-setup": "bin/cli.js"
  },
  "scripts": {
    "check": "node scripts/check-manifest.js",
    "prepublishOnly": "node --check bin/cli.js && node scripts/check-manifest.js"
  },
  "keywords": [
    "axiom",
    "coding-agent",
    "setup",
    "claude",
    "ai-agent"
  ],
  "author": "mcikalmerdeka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcikalmerdeka/axiom-coding-agent-setup.git"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
